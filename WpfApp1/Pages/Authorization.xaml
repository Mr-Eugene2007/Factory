<Page x:Class="WpfApp1.Pages.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Authorization">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <!-- Основная панель авторизации. -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Поле ввода логина -->
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>

            <!-- Поле ввода пароля -->
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="pswbPassword"/>

            <!-- Капча (появляется после нескольких неверных попыток) -->
            <TextBlock Visibility="Hidden"
                       x:Name="txtBlockCaptcha"
                       Text="Капча"/>
            <TextBox Visibility="Hidden"
                     x:Name="txtBoxCaptcha"/>

            <!-- Таймер блокировки (появляется при превышении попыток) -->
            <TextBlock HorizontalAlignment="Center"
                       Visibility="Hidden"
                       x:Name="txtBlockTimer"/>

            <!-- Кнопки входа -->
            <StackPanel Orientation="Horizontal"
                        Height="80"
                        HorizontalAlignment="Center">
                <Button x:Name="btnEnterGuests"
                        Margin="5,15,5,5"
                        Content="Войти как гость"
                        Click="btnEnterGuests_Click"/>

                <Button x:Name="btnEnter"
                        Margin="5,15,5,5"
                        Content="Войти"
                        Click="btnEnter_Click"/>
            </StackPanel>

            <!-- Кнопка восстановления пароля -->
            <Button x:Name="btnForgotPassword"
                    Content="Забыл пароль?"
                    Margin="5"
                    Click="btnForgotPassword_Click"/>

            <!--Панель восстановления пароля.-->
            <StackPanel x:Name="panelRecovery"
                        Visibility="Collapsed"
                        Margin="0,10,0,0">

                <!-- Логин для восстановления -->
                <TextBlock Text="Введите логин:"/>
                <TextBox x:Name="txtRecoveryLogin"/>

                <!-- Email для отправки кода -->
                <TextBlock Text="Введите email для получения кода:"
                           Margin="0,10,0,0"/>
                <TextBox x:Name="txtRecoveryEmail"/>

                <!-- Кнопка отправки кода -->
                <Button Content="Отправить код"
                        Margin="5"
                        Click="btnSendRecoveryCode_Click"/>

                <!-- Ввод кода -->
                <TextBlock Text="Введите код из письма:"/>
                <TextBox x:Name="txtRecoveryCode"/>

                <!-- Подтверждение кода -->
                <Button Content="Подтвердить код"
                        Margin="5"
                        Click="btnConfirmRecoveryCode_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</Page>