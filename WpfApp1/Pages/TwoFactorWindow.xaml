<Window x:Class="WpfApp1.Pages.TwoFactorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение входа"
        Height="180"
        Width="300"
        WindowStartupLocation="CenterScreen">

    <!-- Основная форма -->
    <StackPanel Margin="20">
        <TextBlock Text="Введите код из письма:" Margin="0,0,0,10"/>
        <TextBox x:Name="txtCode" Height="30"/>

        <Button Content="Подтвердить"
                Height="35"
                Margin="0,15,0,0"
                Click="Confirm_Click"/>
    </StackPanel>
</Window>
